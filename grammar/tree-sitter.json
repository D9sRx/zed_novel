      "file-types": ["novel"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Zed Novel Reader format",
    "authors": [
      { "name": "Zed Novel Reader contributors" }
    ],
    "links": {
